# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local Docker image should be pgvector/pgvector:pg16 (not plain postgres:16)
# so the pgvector extension is available for future AI/embedding search
# (see docs/ARCHITECTURE.md §8). Unused by MVP, reserved for Phase 10.
DATABASE_URL="postgresql://bunko:bunko@localhost:5432/bunko?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Object Storage (MinIO locally, S3 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="bunko-dev"
S3_ACCESS_KEY_ID="bunko-minio-admin"
S3_SECRET_ACCESS_KEY="bunko-minio-secret"

# --- Auth ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# --- App ---
PORT=3000
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"

# --- Storage Quotas (see docs/DATA_MODEL.md §5) ---
USER_STORAGE_QUOTA_BYTES=2147483648

# --- Reading Session (see SRS §12.8) ---
SESSION_IDLE_TIMEOUT_MINUTES=5
SESSION_GRACE_WINDOW_MINUTES=15

# --- Continuity Mapping (see SRS §11.8) ---
MAPPING_CONFIDENCE_THRESHOLD=0.6

# --- Book Metadata Providers (Optional, see docs/ARCHITECTURE.md §11) ---
# GOOGLE_BOOKS_API_KEY=""
# HARDCOVER_API_KEY=""

# --- AI Service (Phase 10, optional — see ARCHITECTURE.md §8, docs/AI_DATA_POLICY.md) ---
# Leave unset to run Bunko without AI features. AI_SERVICE_TOKEN is a shared
# secret (16+ chars) that must match the ai-service's own AI_SERVICE_TOKEN.
# AI_SERVICE_URL="http://localhost:8001"
# AI_SERVICE_TOKEN=""
# Per-user cap on generated answers/summaries/insights/recommendations per day.
# AI_DAILY_GENERATION_LIMIT=30
#
# Used by ai-service only (never by the Express API):
# ANTHROPIC_API_KEY=""
# AI_DATABASE_URL="postgresql://bunko_ai:<password>@localhost:5432/bunko"
